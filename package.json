{
  "name": "jaj-dataverse-dev-mcp",
  "version": "0.1.1",
  "description": "Local-first Dataverse MCP for developers, with Azure CLI auth, direct Web API access, and multi-environment support.",
  "type": "module",
  "bin": {
    "jaj-dataverse-dev-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "dev:http": "tsx watch src/http.ts",
    "dev:stdio": "tsx watch src/stdio.ts",
    "start": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "inspect": "mcp-inspector --server-url http://127.0.0.1:3000/mcp --transport http",
    "inspect:tools": "mcp-inspector --cli http://127.0.0.1:3000/mcp --transport http --method tools/list",
    "inspect:stdio": "mcp-inspector npx tsx src/stdio.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "mcp",
    "dataverse",
    "power-platform",
    "dynamics-365",
    "dynamics365",
    "powerapps",
    "power-automate",
    "microsoft",
    "azure-cli",
    "developer-tools",
    "xrm"
  ],
  "author": "Jan-Åge Johnsen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjohnsen/jaj-dataverse-dev-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jjohnsen/jaj-dataverse-dev-mcp/issues"
  },
  "homepage": "https://github.com/jjohnsen/jaj-dataverse-dev-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.7.0",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
